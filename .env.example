# ============================================================
# ClusterDB Monitor - variables de entorno de demostración
# ============================================================
# Copia este archivo a .env y cambia TODOS los valores.
# En Windows:  .\scripts\init-env.ps1
# En Linux/WSL: ./scripts/init-env.sh
#
# Este archivo NO contiene credenciales reales. Los valores son
# marcadores locales para una demo en una sola laptop.

# --- Credenciales de PostgreSQL -------------------------------
POSTGRES_PASSWORD=clusterdb_local_superuser_change_me
REPLICATOR_PASSWORD=clusterdb_local_replicator_change_me
APP_PASSWORD=clusterdb_local_app_change_me
BACKUP_PASSWORD=clusterdb_local_backup_change_me
MONITOR_PASSWORD=clusterdb_local_monitor_change_me

# --- Objetivos de la demostración (no son resultados) ---------
SLA_TARGET_PERCENT=99.9
RTO_TARGET_SECONDS=30
RPO_TARGET_SECONDS=60

# --- Monitoreo ------------------------------------------------
MONITOR_POLL_SECONDS=2
MONITOR_RETENTION_DAYS=30
REPLICATION_LAG_ALERT_BYTES=5242880
# 1 muestra = 2 s. Un failover real puede ser mas corto que dos sondeos.
FAILURE_THRESHOLD_SAMPLES=1

# --- Generador de transacciones -------------------------------
TX_INTERVAL_SECONDS=2

# --- Respaldos ------------------------------------------------
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_COUNT=14
BACKUP_ON_START=true
BACKUP_ON_START_DELAY_SECONDS=25
# La restauración hacia una base temporal está bloqueada por defecto.
ALLOW_RESTORE=false

# --- Presentación ---------------------------------------------
TZ=America/El_Salvador
DASHBOARD_REFRESH_SECONDS=5
